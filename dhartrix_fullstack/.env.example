# Keep this file secret-free; copy it to .env and add your own credentials.
# QpiAI Opt: token from your QpiAI Opt dashboard. Never expose it to browser JavaScript.
QPIAI_OPT_TOKEN=
QPIAI_OPT_BASE_URL=https://opt-server.qpiai.tech/api
# The Opt API docs identify POST /problems/create, but required schema can vary.
# Configure only after checking the current official schema for your account/version.
QPIAI_OPT_CREATE_PATH=/problems/create
# Optional exact JSON request body from the current official Opt docs; leave blank until verified.
QPIAI_OPT_CREATE_PAYLOAD_JSON=

# QpiAI Quantum Cloud SDK API key. Never expose it to browser JavaScript.
QPIAI_QCLOUD_API_KEY=

# Optional live generative AI assistant. This requires an API key and may incur charges.

# Password reset email (Gmail example: smtp.gmail.com, port 587).
# Use a Google App Password, not your normal Gmail password. Keep this file private.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=binduyallamanchi@gmail.com
SMTP_PASSWORD=PASTE_YOUR_GOOGLE_APP_PASSWORD_HERE
SMTP_FROM=binduyallamanchi@gmail.com
SMTP_TIMEOUT_SECONDS=15
